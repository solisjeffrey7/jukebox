#!/data/data/com.termux/files/usr/bin/bash
J="$HOME/jukebox"
PIDFILE="$J/.jukebox.pid"

show_addresses() {
    cd "$J" || return 1
    python - <<'PY'
import server_v2
ip = server_v2.get_local_ip()
port = server_v2.PORT
player = f"http://{ip}:{port}/player"
remote = f"http://{ip}:{port}/remote"
print()
print("\033[1;36m╭────────────────────────────────────────────╮\033[0m")
print("\033[1;36m│        🎤 JUKEBOX IS ALREADY RUNNING       │\033[0m")
print("\033[1;36m╰────────────────────────────────────────────╯\033[0m")
print()
server_v2.print_startup_ui(player, remote)
PY
}

# If already running, show Player + Remote addresses and QR instead of
# trying to start a second server.
if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        show_addresses
        exit 0
    fi
    rm -f "$PIDFILE"
fi

if pgrep -f "$J/server_v2.py" >/dev/null 2>&1; then
    show_addresses
    exit 0
fi

cd "$J" || exit 1
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT
exec "$J/run.sh"
